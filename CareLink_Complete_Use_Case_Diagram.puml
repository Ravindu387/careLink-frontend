@startuml CareLink_Complete_Use_Case_Diagram
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam actorStyle stick
skinparam defaultFontName "Inter, Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam defaultFontColor #1E293B
skinparam ArrowColor #334155
skinparam ArrowFontColor #1E293B
skinparam ArrowFontSize 10
skinparam nodesep 22
skinparam ranksep 65

skinparam actor {
  BackgroundColor #0F172A
  BorderColor #0F172A
  FontColor #0F172A
  FontSize 13
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #1E3A5F
  BorderThickness 1.5
  FontColor #0F172A
  FontSize 11
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0F172A
  BorderThickness 2
  FontColor #0F172A
  FontSize 16
  FontStyle bold
}

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  BorderThickness 1
  FontColor #1E3A5F
  FontSize 13
  FontStyle bold
}

title **CareLink Crisis Management System – Complete UML Use Case Diagram**\n<size:12><color:#475569>NSBM Software Architecture Final Report | Multi-Role Humanitarian Aid & Emergency Coordination Platform</color></size>

' ============================================================================
' PRIMARY HUMAN ACTORS (LEFT SIDE: PUBLIC, FIELD & GOVERNANCE ROLES)
' ============================================================================
actor "Citizen" as Citizen
actor "Partner Officer" as PartnerOfficer
actor "Admin\n(System Administrator)" as Admin
actor "Case Manager" as CaseManager
actor "Emergency Coordinator" as EmergencyCoordinator

' ============================================================================
' PRIMARY HUMAN ACTORS (RIGHT SIDE: OPERATIONAL & LOGISTICS ROLES)
' ============================================================================
actor "Volunteer Coordinator\n(Volunteer Workspace)" as VolunteerCoordinator
actor "Shelter Administrator" as ShelterAdmin
actor "Resource Manager" as ResourceManager
actor "Funding Officer" as FundingOfficer

' ============================================================================
' EXTERNAL SYSTEMS (STEREOTYPED UML SYSTEM ACTORS)
' ============================================================================
actor "Google Gemini AI API\n(gemini-1.5-flash)" as GeminiAPI <<External System>>
actor "Email / SMTP Service\n(Gmail SMTP)" as SmtpService <<External System>>

' ============================================================================
' SYSTEM BOUNDARY: CARELINK CRISIS MANAGEMENT SYSTEM
' ============================================================================
rectangle "CareLink Crisis Management System" as CareLinkSystem {

  ' --------------------------------------------------------------------------
  ' 1. AUTHENTICATION, REGISTRATION & IDENTITY ONBOARDING
  ' --------------------------------------------------------------------------
  package "1. Authentication, Registration & Account Onboarding" as PkgAuth {
    usecase "UC01: Login & Authenticate\n(JWT Bearer Session)" as UC01
    usecase "UC02: Register Public Account\n(Citizen / Volunteer)" as UC02
    usecase "UC03: Register Partner\nOrganisation" as UC03
    usecase "UC04: Complete Single-Use\nStaff Password Setup" as UC04
    usecase "UC37: Submit Organisation\nVerification Documents" as UC37
    usecase "UC38: Submit Requested\nAdditional Verification Info" as UC38
  }

  ' --------------------------------------------------------------------------
  ' 2. SYSTEM ADMINISTRATION & GOVERNANCE
  ' --------------------------------------------------------------------------
  package "2. System Administration & Governance" as PkgAdmin {
    usecase "UC05: Manage Users &\nAccount Status" as UC05
    usecase "UC06: Create & Invite\nInternal Staff Account" as UC06
    usecase "UC07: Generate Single-Use\nPassword Setup Token" as UC07
    usecase "UC08: Manage Roles &\nRole Hierarchy" as UC08
    usecase "UC09: Manage Fine-Grained\nPermissions (41 Claims)" as UC09
    usecase "UC10: Verify Partner\nOrganisations (Approve/Reject)" as UC10
    usecase "UC11: Request Additional\nPartner Verification Info" as UC11
    usecase "UC12: Monitor System Activities,\nAudit Logs & Security Events" as UC12
    usecase "UC13: System Oversight, Analytics\n& SMTP Diagnostics" as UC13
  }

  ' --------------------------------------------------------------------------
  ' 3. CITIZEN RELIEF PORTAL & AI ASSISTANT CHATBOT
  ' --------------------------------------------------------------------------
  package "3. Citizen Relief Portal & AI Chatbot" as PkgCitizen {
    usecase "UC25: Manage Citizen Profile\n& Household Members" as UC25
    usecase "UC26: Submit Emergency\nAssistance Request" as UC26
    usecase "UC27: Upload Supporting\nDocuments" as UC27
    usecase "UC28: View & Update Submitted\nAssistance Requests" as UC28
    usecase "UC29: Track Request Status\n& Case Messaging" as UC29
    usecase "UC30: View Shelters, Nearby\nSupport & Safety Updates" as UC30
    usecase "UC31: Use CareLink AI Assistant\nChatbot (EN / SI / TA)" as UC31
  }

  ' --------------------------------------------------------------------------
  ' 4. CASE MANAGEMENT & TRIAGE
  ' --------------------------------------------------------------------------
  package "4. Case Management & Request Verification" as PkgCase {
    usecase "UC14: View & Claim Unassigned\nAssistance Requests" as UC14
    usecase "UC15: Verify Assistance\nRequests & Identity" as UC15
    usecase "UC16: Review Case Details &\nManage Case Information" as UC16
    usecase "UC17: Triage Cases, Escalate\n& Resolve Duplicates" as UC17
    usecase "UC18: Update Case Status\n& Resolution" as UC18
  }

  ' --------------------------------------------------------------------------
  ' 5. EMERGENCY COORDINATION & AI DECISION SUPPORT
  ' --------------------------------------------------------------------------
  package "5. Emergency Coordination & Human-in-the-Loop AI Decision Support" as PkgEmergency {
    usecase "UC19: View Crisis Operations\nDashboard & Live Map" as UC19
    usecase "UC20: Manage Crisis Incidents\n& Severity Levels" as UC20
    usecase "UC21: Coordinate Emergency Responses\n& Situation Reports" as UC21
    usecase "UC22: Analyse Crisis Situations\n(Resources, Shelters, Volunteers)" as UC22
    usecase "UC23: Generate & View Grounded\nAI Recommendations" as UC23
    usecase "UC24: Review AI Recommendations\n(Approve / Reject / Modify / Defer / Reset)" as UC24
  }

  ' --------------------------------------------------------------------------
  ' 6. PARTNER ORGANISATION COLLABORATION
  ' --------------------------------------------------------------------------
  package "6. Partner Organisation Collaboration" as PkgPartner {
    usecase "UC39: Manage Organisation Profile\n& View Verification Status" as UC39
    usecase "UC40: Manage Assistance Referrals\n& Shared Crisis Events" as UC40
    usecase "UC41: Manage Resource Sharing\n& Collaboration Requests" as UC41
    usecase "UC42: Log Field Activities, Team\nContacts & Partner Reports" as UC42
  }

  ' --------------------------------------------------------------------------
  ' 7. RESOURCE, WAREHOUSE & SUPPLY CHAIN MANAGEMENT
  ' --------------------------------------------------------------------------
  package "7. Resource, Inventory & Logistics Management" as PkgResource {
    usecase "UC43: View & Manage Resource\nInventory & Warehouses" as UC43
    usecase "UC44: Update Resource Quantities\n& Low-Stock Alerts" as UC44
    usecase "UC45: Review Resource Requests\n& Allocate Resources" as UC45
    usecase "UC46: Track Resource Allocation,\nDispatches & Stock Transfers" as UC46
    usecase "UC47: Manage Procurement Orders\n& Suppliers" as UC47
  }

  ' --------------------------------------------------------------------------
  ' 8. SHELTER ADMINISTRATION & OCCUPANCY
  ' --------------------------------------------------------------------------
  package "8. Shelter Administration & Occupancy Management" as PkgShelter {
    usecase "UC48: Manage Shelter Details,\nRooms & Bed Inventory" as UC48
    usecase "UC49: View & Update Shelter\nCapacity & Thresholds" as UC49
    usecase "UC50: Process Accommodation\nRequests & Manage Residents" as UC50
    usecase "UC51: Track Shelter Availability,\nSupplies, Staff & Safety" as UC51
  }

  ' --------------------------------------------------------------------------
  ' 9. VOLUNTEER COORDINATION & DEPLOYMENT
  ' --------------------------------------------------------------------------
  package "9. Volunteer Coordination & Deployment" as PkgVolunteer {
    usecase "UC52: View & Verify Volunteer\nDirectory & Records" as UC52
    usecase "UC53: Manage Volunteer Profiles,\nSkills, Availability & Training" as UC53
    usecase "UC54: Create & Manage Volunteer\nTasks & AI Skill Matching" as UC54
    usecase "UC55: Assign & Deploy Volunteers\nto Field Operations" as UC55
    usecase "UC56: Monitor Volunteer Activities,\nAttendance & Communications" as UC56
  }

  ' --------------------------------------------------------------------------
  ' 10. FUNDING, DONATIONS & FINANCIAL AUDITING
  ' --------------------------------------------------------------------------
  package "10. Funding, Donations & Financial Auditing" as PkgFunding {
    usecase "UC32: View & Manage Donors\n& Humanitarian Campaigns" as UC32
    usecase "UC33: Record & Manage Donations\n& In-Kind Contributions" as UC33
    usecase "UC34: Record Funding Allocations\n& Manage Expenditures" as UC34
    usecase "UC35: Monitor Financial Activities\n& Flagged Transactions" as UC35
    usecase "UC36: Generate Funding &\nTransparency Reports" as UC36
  }
}

' ============================================================================
' UML <<include>> AND <<extend>> RELATIONSHIPS
' ============================================================================
' Partner Registration & Verification includes/extends
UC03 ..> UC37 : <<include>>
UC38 ..> UC03 : <<extend>>\n[Additional Info Requested]
UC11 ..> UC10 : <<extend>>\n[Clarification Needed]

' Admin Staff Provisioning & Single-Use Token Setup
UC06 ..> UC07 : <<include>>
UC04 ..> UC01 : <<extend>>\n[First-Time Staff Onboarding]

' Citizen Request Document Upload
UC27 ..> UC26 : <<extend>>\n[Supporting Evidence Attached]

' AI Decision Support Workflow (Human-in-the-Loop)
UC22 ..> UC23 : <<include>>
UC24 ..> UC23 : <<extend>>\n[Human Review Decision]

